---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, COLORES, ESTADO_CHARTS } from '../../lib/util';
import atlas from '../../../../data/atlas.json';

export async function getStaticPaths() {
  const albumes = await getCollection('albumes');
  return albumes.map((alb) => ({ params: { slug: alb.id }, props: { alb } }));
}

const { alb } = Astro.props;
const { Content } = await render(alb);
const d = alb.data;
const artista = atlas.nodos.artistas.find((a) => a.slug === d.artista_slug);
const grupo = artista?.grupo ?? 'npr';
const estadoClase = d.charts_estado === 'verificado' ? 'ok' : d.charts_estado === 'parcial' ? 'warn' : 'sd';
---
<Base titulo={d.titulo}>
  <header class="page" style={`border-top:4px solid ${COLORES[grupo] ?? 'var(--dim)'}`}><div class="wrap">
    <p class="eyebrow">Álbum · <a href={u(`artista/${d.artista_slug}/`)} style="color:inherit">{d.artista}</a></p>
    <h1>{d.titulo}</h1>
    <div class="links-verif">
      {d.mb_rgid && <a href={`https://musicbrainz.org/release-group/${d.mb_rgid}`}>MusicBrainz ↗</a>}
      <a href={u(`tiempo/`)}>Ver en la línea de tiempo</a>
    </div>
  </div></header>

  <section class="block"><div class="wrap">
    <table class="datos">
      <tr><th>Primer lanzamiento</th><td>{d.primer_lanzamiento ?? 's.d.'} <span class="badge ok">MusicBrainz</span></td></tr>
      <tr><th>Charts</th><td>{d.charts_texto} <span class={`badge ${estadoClase}`}>{ESTADO_CHARTS[d.charts_estado] ?? d.charts_estado}</span></td></tr>
    </table>
  </div></section>

  <section class="block"><div class="wrap analisis">
    <Content />
  </div></section>
</Base>
