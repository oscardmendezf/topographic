---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, COLORES, ESTADO_CHARTS, ERAS, estrellas, tapa } from '../../lib/util';
import atlas from '../../../../data/atlas.json';
import canciones from '../../../../data/canciones.json';
import destacadas from '../../../../data/destacadas.json';

export async function getStaticPaths() {
  const albumes = await getCollection('albumes');
  return albumes.map((alb) => ({ params: { slug: alb.id }, props: { alb } }));
}

const { alb } = Astro.props;
const { Content } = await render(alb);
const d = alb.data;
const lista = (canciones as any)[alb.id] ?? null;
// Canciones que la propia ficha destaca (entradilla o «Recepción y legado»).
const dest = (destacadas as any)[alb.id]?.pistas ?? {};
const hayDest = Object.keys(dest).length > 0;
const dur = (ms: number | null) => {
  if (!ms) return '—';
  const s = Math.round(ms / 1000);
  return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`;
};
const artista = atlas.nodos.artistas.find((a) => a.slug === d.artista_slug);
const grupo = artista?.grupo ?? 'npr';
const estadoClase = d.charts_estado === 'verificado' ? 'ok' : d.charts_estado === 'parcial' ? 'warn' : 'sd';
---
<Base titulo={d.titulo} tipo="Álbum">
  <header class="page" style={`border-top:4px solid ${COLORES[grupo] ?? 'var(--dim)'}`}><div class="wrap cabecera-album">
    <div>
      <p class="eyebrow">Álbum · <a href={u(`artista/${d.artista_slug}/`)} style="color:inherit">{d.artista}</a></p>
      <h1>{d.titulo}</h1>
      <div class="links-verif">
        {d.mb_rgid && <a href={`https://musicbrainz.org/release-group/${d.mb_rgid}`}>MusicBrainz ↗</a>}
        <a href={u(`tiempo/${d.era ?? 'clasica'}/`)}>Ver en la línea de tiempo</a>
      </div>
    </div>
    {tapa(d.mb_rgid, 500) && (
      <img class="tapa" src={tapa(d.mb_rgid, 500)} alt={`Tapa de ${d.titulo}`}
        loading="lazy" onerror="this.remove()" width="180" height="180" />
    )}
  </div></header>

  <style>
    .cabecera-album{display:flex;justify-content:space-between;align-items:flex-end;gap:24px}
    .tapa{width:180px;height:180px;object-fit:cover;border:1px solid var(--line);background:var(--panel);flex-shrink:0}
    @media(max-width:640px){.cabecera-album{flex-direction:column-reverse;align-items:flex-start}}
  </style>

  <section class="block"><div class="wrap">
    <table class="datos">
      <tr><th>Era</th><td>{ERAS[d.era]?.nombre ?? '—'} · {ERAS[d.era]?.rango ?? ''}</td></tr>
      <tr><th>Primer lanzamiento</th><td>{d.primer_lanzamiento ?? 's.d.'} {d.mb_rgid ? <span class="badge ok">MusicBrainz</span> : <span class="badge">sin entidad MB propia</span>}</td></tr>
      <tr><th>Charts</th><td>{d.charts_texto} <span class={`badge ${estadoClase}`}>{ESTADO_CHARTS[d.charts_estado] ?? d.charts_estado}</span></td></tr>
      <tr><th>Recepción crítica</th><td>
        <span class="estrellas">{estrellas(d.estrellas_critica)}</span>
        {d.critica_nota && <span class="nota"> — {d.critica_nota}</span>}
        <span class="badge warn">valoración editorial</span>
      </td></tr>
      <tr><th>Recepción comercial</th><td>
        <span class="estrellas">{estrellas(d.estrellas_comercial)}</span>
        {d.comercial_nota && <span class="nota"> — {d.comercial_nota}</span>}
        {d.comercial_fuente === 'charts'
          ? <span class="badge ok">derivada de charts ({d.charts_estado})</span>
          : <span class="badge warn">estimación editorial</span>}
      </td></tr>
    </table>
  </div></section>

  <style>
    .estrellas{color:var(--acento);font-size:17px;letter-spacing:2px}
    .nota{color:var(--dim);font-size:13px}
  </style>

  <section class="block"><div class="wrap analisis">
    <Content />
    {d.historia && (
      <p class="sub nota-historia">Historia editorial redactada por el Atlas, sin fuentes citadas: los datos duros
        verificables son los de la tabla y los créditos de MusicBrainz.
        <span class="badge warn">historia editorial</span></p>
    )}
  </div></section>

  <style>
    .analisis h2{font-size:19px;margin:30px 0 4px}
    .analisis > p:first-child{font-size:18px;font-style:italic}
    .nota-historia{margin-top:26px;font-size:12.5px}
  </style>

  {lista && (
    <section class="block"><div class="wrap">
      <h2>Canciones</h2>
      <p class="sub">Lista de la edición original{lista.fecha ? ` (${lista.fecha})` : ''} ·
        <a href={`https://musicbrainz.org/release/${lista.release_id}`}> MusicBrainz ↗</a></p>
      {lista.medios.map((m: any, i: number) => (
        <div class="medio">
          {lista.medios.length > 1 && (
            <p class="tag">{m.formato ?? 'Disco'} {i + 1}{m.titulo ? ` · ${m.titulo}` : ''}</p>
          )}
          <table class="datos pistas">
            {m.pistas.map((p: any) => (
              <tr class={dest[`${i + 1}:${p.n}`] ? 'destacada' : undefined}>
                <td class="mono n">{p.n}</td>
                <td>{p.titulo}
                  {dest[`${i + 1}:${p.n}`] && (
                    <span class="marca mono" title={dest[`${i + 1}:${p.n}`].nota}>
                      {estrellas(dest[`${i + 1}:${p.n}`].estrellas)}</span>
                  )}
                </td>
                <td class="mono t">{dur(p.ms)}</td>
              </tr>
            ))}
          </table>
        </div>
      ))}
      {hayDest && (
        <div class="destacadas">
          <p class="tag">Las claves del disco</p>
          {Object.entries(dest).map(([, v]: [string, any]) => (
            <p class="clave">
              <span class="mono num">{lista.medios.length > 1 ? `${v.medio}·${v.n}` : v.n}</span>
              <b>{v.titulo}</b>
              <span class="mono est">{estrellas(v.estrellas)}</span>
              <span class="por">{v.nota}</span>
            </p>
          ))}
          <p class="sub fuente-dest">Elección editorial del Atlas sobre el tracklist verificado:
            qué piezas sostienen el disco. Las estrellas son de la canción, no del álbum.</p>
        </div>
      )}
    </div></section>
  )}

  <style>
    .medio{margin-bottom:18px}
    .pistas{max-width:640px}
    .pistas .n{width:34px;color:var(--dim);font-size:12px}
    .pistas tr.destacada td{color:var(--ink)}
    .marca{color:var(--acento);font-size:10px;margin-left:9px;letter-spacing:1px;cursor:help}
    .destacadas{margin-top:22px;max-width:660px;border-top:1px solid var(--line);padding-top:14px}
    .clave{font-size:14px;margin:9px 0;line-height:1.5}
    .clave .num{color:var(--dim);font-size:11px;margin-right:8px}
    .clave .est{color:var(--acento);font-size:11px;letter-spacing:1px;margin:0 8px}
    .clave .por{color:#b9b3a4}
    .fuente-dest{margin-top:14px;font-size:12.5px}
    .pistas .t{width:56px;text-align:right;color:var(--dim);font-size:12px}
  </style>
</Base>
