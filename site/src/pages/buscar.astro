---
import Base from '../layouts/Base.astro';
import { u } from '../lib/util';
const base = u('/');
---
<Base titulo="Buscar" sinIndice={true}>
  <header class="page"><div class="wrap">
    <p class="eyebrow">Búsqueda en todo el atlas</p>
    <h1>Buscar</h1>
    <p class="lede">Artistas, discos, personas de la red y análisis largos: el texto completo de
    todas las fichas. Escribí un nombre, un instrumento, un estudio o una idea.</p>
  </div></header>

  <section class="block"><div class="wrap">
    <div id="buscador" data-base={base}></div>
    <p id="buscador-error" class="sub" hidden></p>
    <noscript><p class="sub">La búsqueda requiere JavaScript.</p></noscript>
  </div></section>
</Base>

<style is:global>
#buscador{
  --pagefind-ui-scale: .9;
  --pagefind-ui-primary: #D08C2E;
  --pagefind-ui-text: #E9E2D0;
  --pagefind-ui-background: #1B212A;
  --pagefind-ui-border: #2A313C;
  --pagefind-ui-tag: #20262f;
  --pagefind-ui-border-width: 1px;
  --pagefind-ui-border-radius: 4px;
  --pagefind-ui-image-border-radius: 2px;
  --pagefind-ui-font: Georgia, serif;
  min-height: 200px;
}
#buscador .pagefind-ui__result-link{color:var(--acento)}
#buscador-error{color:#d9b44a}
</style>

<script is:inline>
  (function () {
    const cont = document.getElementById('buscador');
    const err = document.getElementById('buscador-error');
    const base = cont.dataset.base;
    // El bundle de Pagefind deduce su ruta de document.currentScript, que es null
    // cuando el <script> se inyecta desde JS: hay que pasarle bundlePath a mano.
    const bundlePath = base + 'pagefind/';

    function fallar(msg) {
      err.hidden = false;
      err.textContent = msg;
    }

    const css = document.createElement('link');
    css.rel = 'stylesheet';
    css.href = bundlePath + 'pagefind-ui.css';
    document.head.appendChild(css);

    const js = document.createElement('script');
    js.src = bundlePath + 'pagefind-ui.js';
    js.onload = function () {
      try {
        new PagefindUI({
          element: '#buscador',
          bundlePath: bundlePath,
          baseUrl: base,
          showImages: false,
          showSubResults: true,
          pageSize: 8,
          autofocus: true,
          translations: {
            placeholder: 'Buscar en el atlas…',
            zero_results: 'Sin resultados para «[SEARCH_TERM]»',
            clear_search: 'Limpiar',
            load_more: 'Más resultados',
            filters_label: 'Filtrar por tipo',
            many_results: '[COUNT] resultados por «[SEARCH_TERM]»',
            one_result: 'Un resultado por «[SEARCH_TERM]»',
            searching: 'Buscando…',
          },
        });
      } catch (e) {
        fallar('No se pudo iniciar la búsqueda: ' + e.message);
      }
    };
    js.onerror = function () {
      fallar('Falta el índice de búsqueda. En desarrollo se genera con «npm run search:index»; ' +
             'en el sitio publicado lo genera el build.');
    };
    document.head.appendChild(js);
  })();
</script>
