---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { u, COLORES, ERAS, estrellas, tapa } from '../../lib/util';
import atlas from '../../../../data/atlas.json';

export async function getStaticPaths() {
  return ['clasica', 'siguiente', 'moderna'].map((era) => ({ params: { era } }));
}

const { era } = Astro.params;
const info = ERAS[era];
const grupoDe = Object.fromEntries(atlas.nodos.artistas.map((a) => [a.slug, a.grupo]));
const albumes = (await getCollection('albumes')).filter((a) => a.data.era === era);
const porAnio = new Map<number, typeof albumes>();
for (const alb of albumes) {
  const y = alb.data.anio_ficha;
  if (!porAnio.has(y)) porAnio.set(y, []);
  porAnio.get(y)!.push(alb);
}
const anios = [...porAnio.keys()].sort();
for (const y of anios) {
  porAnio.get(y)!.sort((a, b) => (a.data.primer_lanzamiento ?? '9999').localeCompare(b.data.primer_lanzamiento ?? '9999'));
}
---
<Base titulo={`Línea de tiempo ${info.rango}`}>
  <header class="page"><div class="wrap">
    <p class="eyebrow">{info.nombre} · año por año · {albumes.length} fichas</p>
    <h1>Línea de tiempo {info.rango}</h1>
    <nav class="eras mono">
      {Object.entries(ERAS).map(([slug, e]) => (
        <a href={u(`tiempo/${slug}/`)} class={slug === era ? 'on' : ''}>{e.rango}</a>
      ))}
    </nav>
  </div></header>

  <main class="wrap tl">
    {anios.map((y) => (
      <div class="year">
        <span class="ylabel mono">{y}</span>
        {porAnio.get(y)!.map((alb) => (
          <a class="al" href={u(`album/${alb.id}/`)}>
            <span class="bar" style={`background:${COLORES[grupoDe[alb.data.artista_slug] ?? 'npr'] ?? 'var(--dim)'}`}></span>
            {tapa(alb.data.mb_rgid) && (
              <img class="mini-tapa" src={tapa(alb.data.mb_rgid)} alt="" loading="lazy"
                onerror="this.style.visibility='hidden'" width="52" height="52" />
            )}
            <div>
              <h4>{alb.data.titulo} <em>{alb.data.artista}</em></h4>
              <p>{alb.body?.slice(0, 180)}{(alb.body?.length ?? 0) > 180 ? '…' : ''}</p>
              <p class="stars mono">
                <span title={alb.data.critica_nota ?? 'valoración editorial'}>crítica {estrellas(alb.data.estrellas_critica)}</span>
                <span title={alb.data.comercial_fuente === 'charts' ? 'derivada de charts' : 'estimación editorial'}> · comercial {estrellas(alb.data.estrellas_comercial)}</span>
              </p>
            </div>
            <span class="c mono">
              {alb.data.charts_texto}
              {alb.data.charts_estado === 'memoria' && <b class="sd" title="chart sin verificar, tratar como s.d.">sin verificar</b>}
              {alb.data.charts_estado === 'parcial' && <b class="pv" title="verificación parcial">verif. parcial</b>}
            </span>
          </a>
        ))}
      </div>
    ))}
  </main>
</Base>

<style>
.eras{display:flex;gap:8px;margin-top:16px}
.eras a{font-size:12px;letter-spacing:.08em;color:var(--dim);text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:5px 14px}
.eras a.on{color:var(--ink);border-color:var(--acento)}
.eras a:hover{color:var(--ink)}
.tl{padding:34px 20px 44px}
.year{position:relative;padding:8px 0 26px 84px;border-left:2px solid var(--line);margin-left:28px}
.ylabel{position:absolute;left:-30px;top:8px;width:58px;height:58px;border-radius:50%;background:var(--panel2);border:2px solid var(--line);display:flex;align-items:center;justify-content:center;font-size:14px;letter-spacing:.05em}
.al{display:grid;grid-template-columns:4px auto 1fr auto;gap:0 14px;background:var(--panel);border:1px solid var(--line);margin-bottom:8px;padding:10px 14px 10px 0;text-decoration:none;align-items:start}
.mini-tapa{width:52px;height:52px;object-fit:cover;border:1px solid var(--line);background:var(--panel2)}
.al:not(:has(.mini-tapa)){grid-template-columns:4px 1fr auto}
.al:hover{background:var(--panel2)}
.al h4{font-size:15.5px;font-weight:600}
.al h4 em{font-style:normal;color:var(--dim);font-weight:400;font-size:13px;margin-left:8px}
.al p{font-size:13.5px;color:#b9b3a4;margin-top:3px;max-width:72ch}
.al .stars{font-size:11px;color:var(--acento);margin-top:5px}
.al .stars span[title]{cursor:help}
.al .c{font-size:12px;color:var(--dim);white-space:nowrap;align-self:start;padding-top:2px}
.al .c b{display:block;font-weight:400;font-size:10px;letter-spacing:.06em;text-align:right}
.al .c b.sd{color:#c96f6f}
.al .c b.pv{color:#d9b44a}
@media(max-width:640px){.year{padding-left:56px;margin-left:20px}.ylabel{left:-24px;width:46px;height:46px;font-size:12px}.al{grid-template-columns:4px auto 1fr}.al .c{grid-column:3;padding:4px 0 0}}
</style>
